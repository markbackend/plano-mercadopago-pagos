# Copiar este archivo como .env y completar. NUNCA subir el .env al repositorio.

# --- Modo -------------------------------------------------------------------
# simulador  = todo local, sin cuenta ni internet (para demo y desarrollo)
# sandbox    = API real de Mercado Pago con credenciales de PRUEBA (cuentas de prueba)
# produccion = cobros reales
MP_MODO=simulador

# --- Credenciales de Mercado Pago ---------------------------------------------
# Panel: https://www.mercadopago.com.ar/developers/panel/app -> tu aplicación
#   "Credenciales de prueba" (sandbox) o "Credenciales de producción".
# Access token: APP_USR-... (o TEST-... en cuentas viejas). En modo simulador puede quedar vacío.
MP_ACCESS_TOKEN=
# Panel -> tu aplicación -> Webhooks -> "Clave secreta". Obligatoria en producción.
MP_WEBHOOK_SECRET=
# No cambiar salvo para apuntar a un mock propio.
MP_API_BASE=https://api.mercadopago.com
MP_TIMEOUT_SEG=15
# Antigüedad máxima (segundos) del ts de la firma. 0 = no se controla
# (es seguro igual: el estado siempre se consulta a la API y todo es idempotente).
MP_FIRMA_TOLERANCIA_SEG=0

# --- URLs ---------------------------------------------------------------------
# URL pública de ESTA API (Mercado Pago tiene que poder llegar). Con localhost no se manda
# notification_url: usar un túnel (cloudflared / ngrok) para probar webhooks en sandbox.
BASE_URL_PUBLICA=http://127.0.0.1:8000
# A dónde vuelve el comprador después de pagar. Vacías = páginas simples de esta API.
URL_EXITO=
URL_FALLO=
URL_PENDIENTE=

# --- Tienda -------------------------------------------------------------------
# ARS (Argentina), BRL, CLP, MXN, COP, PEN, UYU. Tiene que coincidir con el país de la cuenta.
MONEDA=ARS
# Aparece en el resumen de la tarjeta (máx. 22 caracteres)
NOMBRE_TIENDA=Mi tienda

# --- Servidor -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DB_PATH=datos/pagos.db
LOG_NIVEL=INFO
# Si se define, /ordenes exige el encabezado X-API-Key con este valor (recomendado en producción).
# Generar una: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Avisos al dueño cuando se aprueba un pago (opcionales) --------------------
# Webhook propio: recibe un POST JSON (sirve para Slack, Discord, n8n, Zapier, Make...)
AVISO_WEBHOOK_URL=
# Email por SMTP. Gmail: smtp.gmail.com, puerto 587, con "contraseña de aplicación".
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_STARTTLS=true
SMTP_REMITENTE=
# Uno o varios separados por coma
AVISO_EMAIL_PARA=
